# Copy to .env and fill in real values
DATABASE_URL="mysql://root:password@localhost:3306/ewaste"

PORT=4000
FRONTEND_ORIGIN="http://localhost:3000"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# Legacy single-token TTL (kept for back-compat with /me etc.)
JWT_EXPIRES_IN="24h"

# Email delivery (Nodemailer).
# Option C — real Gmail delivery (recommended for verification emails to real inboxes):
#   1. Enable 2-Step Verification on your Google account.
#   2. Google Account → Security → App passwords → generate one for "Mail" / "Other".
#   3. Paste the 16-character app password into SMTP_PASS below (no spaces).
#   4. Set SMTP_USER + MAIL_FROM to the same Gmail address (Gmail rewrites mismatched From).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASS="paste-your-16-char-app-password-here"
MAIL_FROM="E-Waste <your-gmail-address@gmail.com>"

# Alternative — Mailtrap sandbox (emails appear in mailtrap.io UI, not real inbox):
#   SMTP_HOST="smtp.mailtrap.io"
#   SMTP_PORT=2525
#   SMTP_USER="<mailtrap user>"
#   SMTP_PASS="<mailtrap pass>"
#
# Alternative — local-only logging (no real delivery): leave SMTP_HOST blank.

# Admin seed credentials (used by prisma/seed.js)
SEED_ADMIN_EMAIL="admin@ewaste.local"
SEED_ADMIN_PASSWORD="ChangeMe!123"
SEED_ADMIN_NAME="Platform Admin"
